{
  "schema": 1,
  "id": "c7998528-c9db-4b22-8c8f-a16e0affd94d",
  "type": "toolplugin",
  "publisher": "bmcshell",
  "shortName": "ipmi",
  "name": "bmcshell-tool-ipmi",
  "displayName": "BMCShell IPMI",
  "description": "执行当前目标的原生 IPMI 命令，支持二进制响应输出。",
  "summary": "执行当前目标的原生 IPMI 命令，支持二进制响应输出。",
  "version": "1.0.3",
  "repository": "https://github.com/BMCShell/bmcshell-tool-ipmi",
  "coreApi": 1,
  "platforms": [
    "windows-amd64"
  ],
  "help": "help.json",
  "changelog": "changelog.json",
  "settings": [
    {
      "key": "color",
      "path": "tools.ipmi",
      "label": "终端颜色",
      "hint": "设置 IPMI 命令回显和报告字段名的颜色。",
      "type": "enum",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "自动", "hint": "支持颜色的终端会使用颜色，NO_COLOR 仍可关闭颜色。" },
        { "value": "off", "label": "关闭", "hint": "使用纯文本命令回显和报告输出。" }
      ],
      "env": "BMCSHELL_IPMI_COLOR"
    }
  ],
  "repairSuggestions": "repair.json",
  "assets": [
    "repair.json",
    "tool/compat/common.sh",
    "tool/compat/ipmi.sh",
    "tool/compat/input.sh",
    "tool/compat/auth.sh"
  ],
  "provides": {
    "tools": {
      "ipmitool": {
        "scope": "session",
        "runtime": "bash",
        "entry": "tool/entry.sh",
        "requires": [
          "target.ip"
        ]
      },
      "bmc_v2_auth": {
        "scope": "session",
        "runtime": "bash",
        "entry": "tool/entry.sh",
        "requires": [
          "target.ip"
        ]
      }
    }
  },
  "systemDependencies": [
    {
      "id": "ipmitool",
      "requiredBy": ["ipmitool"]
    }
  ]
}
